%%{init: {'theme':'base','themeVariables':{'fontSize':'15px','fontFamily':'Segoe UI, Helvetica, Arial'}}}%%
flowchart TB

%% ================================================================
%% ONE PURCHASE, TOP TO BOTTOM.
%% The diagram is organised by WORKFLOW STAGE (Stage 1 -> Stage 6),
%% not just by architectural layer -- follow the stage numbers down
%% the page to trace exactly how one purchase moves through the
%% system. Shared infrastructure that every stage touches (data,
%% the durable workflow engine, observability) is drawn as thin
%% dotted "side rails" so it never clutters the main path.
%% ================================================================

%% ---------------- ACTORS ----------------
subgraph ACTORS["Human &amp; Client -- React / Next.js"]
    direction LR
    HUMAN["Human Buyer"]
    CHAT["Conversational<br/>Checkout UI"]
    CONSOLE["Consent &amp;<br/>Revocation Console"]
    MDASH["Merchant<br/>Dashboard"]
end
HUMAN --> CHAT
HUMAN --> CONSOLE

%% ---------------- STAGE 1 : DELEGATE ----------------
subgraph S1["STAGE 1 -- DELEGATE"]
    direction LR
    MANDATE["sign Intent Mandate<br/><i>budget - category - merchant - TTL</i>"]
end
CONSOLE -->|"sign"| MANDATE

%% ---------------- STAGE 2 : PRE-HAND CHECKS ----------------
subgraph S2["STAGE 2 -- PRE-HAND CHECKS (before any LLM call)"]
    direction LR
    PRECHECK["Pre-hand Checks<br/><i>mandate validity - input sanitisation<br/>session request-budget</i>"]
end
MANDATE -->|"active mandate"| PRECHECK
CHAT -->|"NL goal"| PRECHECK
PRECHECK -.->|"fail: typed reject,<br/>zero LLM calls"| CHAT

%% ---------------- STAGE 3 : SHOP & UPSELL (agentic pipeline) ----------------
subgraph S3["STAGE 3 -- SHOP &amp; UPSELL: the agentic pipeline (Python)"]
    direction TB
    AORCH["Orchestrator Agent (LangGraph)<br/><i>owns Purchase Session<br/>sole caller of checkout</i>"]
    WDISC["Discovery / Search<br/>Worker"]
    WCART["Cart-Composer<br/>Worker"]
    WCLAR["Clarification<br/>Worker"]
    RELEVANCE["Relevance Service<br/>(ESCI-trained)"]
    UPSELL["Upsell / Cross-sell<br/>Model"]
    CONFIDENCE["Purchase Confidence<br/>Scorer"]
    AORCH -->|"search"| WDISC
    AORCH -->|"compose"| WCART
    AORCH -.->|"ambiguous"| WCLAR
    WDISC -->|"rank"| RELEVANCE
    WCART -->|"complements"| UPSELL
    WCART -->|"score"| CONFIDENCE
end
PRECHECK -->|"pass: dispatch"| AORCH
WCLAR -.->|"ask human"| CHAT

%% ---------------- MERCHANT STOREFRONT (bridge, stage 3 -> 4) ----------------
subgraph MSTORE["Merchant Storefront -- MCP (Rust)"]
    direction LR
    MCP["search_catalog - get_variants<br/>create_cart - checkout"]
    DISCOVERY["Discovery Surface<br/>schema.org - agents.txt"]
end
WDISC -->|"search_catalog"| MCP
WCART -->|"create_cart"| MCP
AORCH -->|"checkout (ONLY caller)"| MCP
DISCOVERY -.->|"advertises tools"| WDISC

%% ---------------- STAGE 4 : GATE ----------------
subgraph S4["STAGE 4 -- GATE: the hard, deterministic checkpoint (Rust)"]
    direction LR
    KERNEL["Mandate &amp; Consent Kernel<br/><b>HARD GATE</b><br/>signature - per-txn cap - cumulative<br/>category/merchant - TTL - cart integrity"]
    SIGNER["ed25519<br/>Verify"]
    RESERVE["Reserve-Pay<br/>Ledger"]
    KERNEL --> SIGNER
    KERNEL --> RESERVE
end
MCP -->|"submit cart + mandate"| KERNEL
KERNEL -.->|"REFUSED / NEEDS_HUMAN<br/>(typed reason)"| AORCH
AORCH -.->|"needs approval"| CONSOLE

%% ---------------- STAGE 5 : PAY ----------------
subgraph S5["STAGE 5 -- PAY: execute the authorised charge"]
    direction LR
    EXEC["Payment Orchestrator<br/>(Rust) -- idempotent"]
    TOKEN["Delegated Token<br/>(scoped, single-use)"]
    EXEC --> TOKEN
end
KERNEL -->|"APPROVED"| EXEC
CONSOLE -.->|"REVOKE"| EXEC

subgraph RZP["Razorpay (test mode)"]
    direction LR
    RZP_API["Orders - AutoPay<br/>Payment Links"]
    RZP_WH["Webhooks<br/>(HMAC-verified)"]
end
TOKEN -->|"charge"| RZP_API
RZP_WH -->|"paid / captured"| EXEC

%% ---------------- STAGE 6 : PROVE ----------------
subgraph S6["STAGE 6 -- PROVE: explain and record"]
    direction LR
    LEDGERWRITE["Hash-chained<br/>audit_entry"]
    EXPLAIN["Explanation<br/>Service (LLM)"]
    LEDGERWRITE --> EXPLAIN
end
KERNEL -->|"gate_decision"| LEDGERWRITE
EXEC -->|"payment_effect"| LEDGERWRITE
MDASH -.->|"reads"| LEDGERWRITE

%% ---------------- SIDE RAIL: DATA LAYER ----------------
subgraph DATA["Data Layer -- shared infrastructure"]
    direction LR
    PG[("PostgreSQL")]
    REDIS[("Redis")]
    VDB[("Search Index")]
end
MCP -.-> PG
MCP -.-> VDB
RELEVANCE -.-> VDB
UPSELL -.-> PG
KERNEL -.-> REDIS
EXEC -.-> REDIS
LEDGERWRITE -.-> PG

%% ---------------- SIDE RAIL: DURABLE WORKFLOW ----------------
WF["Durable Workflow Engine<br/>(Temporal / Restate)"]
PRECHECK -.-> WF
KERNEL -.-> WF
EXEC -.-> WF

%% ---------------- SIDE RAIL: OBSERVABILITY ----------------
OTEL["OpenTelemetry -&gt; Grafana"]
PRECHECK -.-> OTEL
AORCH -.-> OTEL
KERNEL -.-> OTEL
EXEC -.-> OTEL

%% ============ STYLING (one colour per workflow stage) ============

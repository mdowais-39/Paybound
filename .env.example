# Paybound environment — copy to `.env` and fill in. `.env` is git-ignored.
# Never commit real secrets.

# --- Gateway / infra ---
PAYBOUND_GATEWAY_PORT=8080
# The Rust services read PAYBOUND_DATABASE_URL; the Python services (agent,
# campaign, run_backend.sh) read plain DATABASE_URL — set both to the same
# value. Port 5433, not the Postgres default 5432, to avoid clashing with a
# local Postgres install (see docs/DECISIONS.md, Phase 1).
DATABASE_URL=postgres://paybound:paybound@localhost:5433/paybound
PAYBOUND_DATABASE_URL=postgres://paybound:paybound@localhost:5433/paybound
PAYBOUND_REDIS_URL=redis://localhost:6379
PAYBOUND_OTLP_ENDPOINT=http://localhost:4317
PAYBOUND_SERVICE_NAME=paybound-gateway

# --- Razorpay test mode ---
# From razorpay.com -> Test Mode -> Settings -> API Keys. Test keys only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Set to true to rehearse the full purchase flow (kernel gate, audit chain,
# AUTHORIZED / NEEDS_HUMAN-approve) WITHOUT spending the test-mode account's
# limited real payment-link quota -- only the actual Razorpay call is
# skipped; everything else is genuine. Leave unset/false to create real
# test-mode payment links. Always restore to false after a dry-run session.
PAYBOUND_DRY_RUN=false

# --- LLM API key for the product runtime ---
# Powers the Orchestrator's goal-parsing and the audit Narrator (Gemini,
# via a raw REST call in services/agent/llm.py — no SDK dependency). Get one
# from https://aistudio.google.com/apikey.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Mandate signing (ed25519) ---
# Generated locally; the private key is git-ignored and never committed.
PAYBOUND_SIGNING_KEY_PATH=./signing_key.ed25519

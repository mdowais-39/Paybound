# Paybound environment — copy to `.env` and fill in. `.env` is git-ignored.
# Never commit real secrets (Part F #7).

# --- Gateway / infra ---
PAYBOUND_GATEWAY_PORT=8080
PAYBOUND_DATABASE_URL=postgres://paybound:paybound@localhost:5432/paybound
PAYBOUND_REDIS_URL=redis://localhost:6379
PAYBOUND_OTLP_ENDPOINT=http://localhost:4317
PAYBOUND_SERVICE_NAME=paybound-gateway

# --- Razorpay test mode (Part G #2) ---
# From razorpay.com -> Test Mode -> Settings -> API Keys. Test keys only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- LLM API key for the product runtime (Part G #3) ---
# Powers the Orchestrator Agent's reasoning and the Explanation service.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# (or, if you prefer OpenAI: OPENAI_API_KEY=sk-xxxx and set LLM_PROVIDER=openai)
LLM_PROVIDER=anthropic

# --- Mandate signing (ed25519) ---
# Generated locally; the private key is git-ignored and never committed.
PAYBOUND_SIGNING_KEY_PATH=./signing_key.ed25519
